# Bind to all interfaces for containers and hosted deployments.
HOST=0.0.0.0
# Local fallback only. A hosting platform's PORT environment variable takes precedence.
PORT=9000
LOG_LEVEL=INFO

# Comma-separated exact frontend origins. Set this to the deployed frontend origin.
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Scan resource limits. The request and page caps cannot exceed 500.
WEBSENTINEL_MAX_PAGES=500
WEBSENTINEL_MAX_REQUESTS=500
WEBSENTINEL_TIMEOUT=10
WEBSENTINEL_MAX_BODY_BYTES=1000000
WEBSENTINEL_MAX_REDIRECTS=10
WEBSENTINEL_TOTAL_TIMEOUT=300

# Optional browser configuration. Leave empty to auto-detect Chromium and use backend/.auth.
WEBSENTINEL_CHROMIUM_EXECUTABLE=
WEBSENTINEL_BROWSER_STATE_DIR=
